# RelayGuard Local Environment Configuration
# NOTICE: These are development-only defaults for local Docker/PostgreSQL execution.
# NEVER use these credentials or connection strings in a production environment.

# Database URL for RelayGuard application and test suite.
# Default connects to local PostgreSQL on standard port 5432:
DATABASE_URL=postgresql://relayguard:relayguard_dev_password@localhost:5432/relayguard

# If running via Docker Compose with default port mapping (5434:5432):
# DATABASE_URL=postgresql://relayguard:relayguard_dev_password@localhost:5434/relayguard

# Docker Compose PostgreSQL environment variables (used by compose.yaml)
POSTGRES_DB=relayguard
POSTGRES_USER=relayguard
POSTGRES_PASSWORD=relayguard_dev_password
POSTGRES_PORT=5434
